# Plaibook Supabase project (same database the app uses). Service role key: server-only.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /jobs/enqueue and friends (Render cron jobs send it as a Bearer token).
COLLEGE_TRIGGER_SECRET=

# Public read API (/v1, see docs/API.md). It answers anonymous requests at API_ANON_RATE_LIMIT_PER_MIN per
# client IP; a named key raises that to API_RATE_LIMIT_PER_MIN. CORS_ORIGINS restricts only keyed browser
# calls — keyless responses are readable from anywhere.
COLLEGE_API_KEYS=plaibook:replace-with-a-32-char-random-key
CORS_ORIGINS=https://www.plaibook.soccer,https://plaibook.soccer
API_RATE_LIMIT_PER_MIN=600
# The site's own pages get five times this (several calls per page view, and offices share one address).
API_ANON_RATE_LIMIT_PER_MIN=60
PUBLIC_URL=https://plaibook-college-scraper.onrender.com

# Search engines (src/seo). Canonical URLs, Open Graph and sitemaps use PUBLIC_URL.
# Google Search Console HTML-file verification: the file name Google gives, e.g. google1234abcd5678.html.
# The service then answers GET /<that name> with "google-site-verification: <that name>".
GSC_VERIFICATION_FILE=
# IndexNow key (8-128 letters, digits or dashes); served at GET /<key>.txt.
INDEXNOW_KEY=

# Appears in the crawler User-Agent so site operators can reach us.
CONTACT_EMAIL=hoosieraisolutions@gmail.com

# Optional: base URL of a self-hosted henrygd/ncaa-api used only if NCAA's persisted-query
# hashes cannot be recovered automatically (e.g. https://ncaa-api.internal).
NCAA_API_BASE=

# Safety: writes to a non-local Supabase host are refused unless this is "1".
COLLEGE_ALLOW_PROD=0

# Politeness knobs (defaults shown).
CRAWL_PER_HOST_RPS=1
CRAWL_GLOBAL_CONCURRENCY=8
LOG_LEVEL=info
PORT=8080

# Enable the in-process scheduler (hourly in season, nightly, weekly). Leave 0 locally.
SCHEDULER_ENABLED=0
# Only used by scripts/render-deploy.mjs (never by the service itself).
RENDER_API_KEY=
