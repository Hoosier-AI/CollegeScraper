# Plaibook Supabase project (same database the app uses). Service role key: server-only.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /jobs/enqueue and friends (Render cron jobs send it as a Bearer token).
COLLEGE_TRIGGER_SECRET=

# Appears in the crawler User-Agent so site operators can reach us.
CONTACT_EMAIL=hoosieraisolutions@gmail.com

# Optional: base URL of a self-hosted henrygd/ncaa-api used only if NCAA's persisted-query
# hashes cannot be recovered automatically (e.g. https://ncaa-api.internal).
NCAA_API_BASE=

# Safety: writes to a non-local Supabase host are refused unless this is "1".
COLLEGE_ALLOW_PROD=0

# Politeness knobs (defaults shown).
CRAWL_PER_HOST_RPS=1
CRAWL_GLOBAL_CONCURRENCY=8
LOG_LEVEL=info
PORT=8080

# Enable the in-process scheduler (hourly in season, nightly, weekly). Leave 0 locally.
SCHEDULER_ENABLED=0
# Only used by scripts/render-deploy.mjs (never by the service itself).
RENDER_API_KEY=
